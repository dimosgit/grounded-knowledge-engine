{
  "name": "cockpit",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "sync:content": "tsx scripts/sync-markdown.ts",
    "watch:content": "tsx scripts/watch-markdown.ts",
    "dev": "concurrently -k \"npm run watch:content\" \"vite\"",
    "dev:demo": "npm run sync:content -- --public && vite --open '/#/graph'",
    "prebuild": "npm run sync:content -- --public",
    "build": "vite build",
    "test:production-boundary": "tsx scripts/production-boundary.ts",
    "test:bundle-budget": "tsx scripts/bundle-budget.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"*.{ts,json}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "KB_PREVIEW_SOURCE_FOLDERS=demo-kb:kb npm run sync:content",
    "check:kb-topics": "tsx scripts/check-topic-module-ownership.ts",
    "check:kb-digests": "tsx scripts/check-kb-digests.ts",
    "check:kb-maintenance": "tsx scripts/check-kb-maintenance-cadence.ts",
    "check:kb": "npm run check:kb-topics && npm run check:kb-digests && npm run check:kb-maintenance",
    "compact:topic": "tsx scripts/compact-topic.ts",
    "apply:topic-frontmatter": "tsx scripts/apply-topic-frontmatter.ts",
    "backfill:quick-recall": "tsx scripts/backfill-quick-recall.ts",
    "check:core": "tsx scripts/core-compatibility.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
